# HMIS Inference — frontend (Vite) environment configuration
#
# Vite only exposes variables prefixed with VITE_ to the client. Anything
# else here is silently ignored — keep secrets out of this file entirely.

# Base URL where the FastAPI backend is reachable.
# Use http://localhost:8000 for local dev, or your deployed API URL in prod.
VITE_API_BASE_URL=http://localhost:8000

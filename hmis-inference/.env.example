# HMIS Inference — backend environment configuration
#
# Copy this file to `.env` next to it and fill in real values for deployment.
# Loaded by `load_dotenv()` in backend/main.py on application startup.

# ---------------------------------------------------------------------------
# LLM provider — public-health analysis
# ---------------------------------------------------------------------------
#   groq   -> Groq cloud API (requires GROQ_API_KEY below)
#   ollama -> Local Ollama server reachable at OLLAMA_BASE_URL
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=replace-me-with-a-real-key

# Per-provider model overrides (defaults shown).
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Database — Timescale / Postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://hmis:hmis_password@postgres:5432/hmis

# ---------------------------------------------------------------------------
# Redis — caching + Celery broker
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# ChromaDB — vector store for RAG policy retrieval
# ---------------------------------------------------------------------------
CHROMA_PATH=./chroma_db

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin requests.
# In dev, the Vite default is http://localhost:5173. For production, replace
# with your deployed frontend URL (and any preview/staging environments).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Optional API-key auth
# ---------------------------------------------------------------------------
# When set, the backend's APIKeyGate middleware rejects any request to
# /api/v1/* that doesn't carry either the `X-API-Key` header set to this
# value, or an `Authorization: Bearer <value>` header. Leave unset for
# local dev (the server logs a warning at boot). For any internal-network
# or public deploy, set this to a long random string and pair it with
# `VITE_API_KEY` at frontend build time.
# API_KEY=some-long-random-secret

# HMIS Inference — backend environment configuration
#
# Copy this file to `.env` next to it and fill in real values for deployment.
# Loaded by `load_dotenv()` in backend/main.py on application startup.
#
# The env vars are grouped below by subsystem. Every variable is
# optional — the application picks sensible defaults when a key is
# absent. See the "Env Vars" section in README.md for the full
# reference (defaults, valid ranges, who reads each).

# ---------------------------------------------------------------------------
# LLM provider — public-health analysis (Workstream 4)
# ---------------------------------------------------------------------------
#   groq   -> Groq cloud API (requires GROQ_API_KEY below)
#   ollama -> Local Ollama server reachable at OLLAMA_BASE_URL
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Get one at https://console.groq.com/keys
GROQ_API_KEY=replace-me-with-a-real-key

# Per-provider model overrides (defaults shown).
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Database — Timescale / Postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://hmis:hmis_password@postgres:5432/hmis

# ---------------------------------------------------------------------------
# Redis — caching + Celery broker + pub/sub fan-out
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# ChromaDB — vector store for RAG policy retrieval (legacy / inactive)
# ---------------------------------------------------------------------------
CHROMA_PATH=./chroma_db

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin requests.
# In dev, the Vite default is http://localhost:5173. For production, replace
# with your deployed frontend URL (and any preview/staging environments).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Authentication — Phase 4 RBAC + JWT (canonical path)
# ---------------------------------------------------------------------------
# HMAC signing key for JWT access + refresh tokens. REQUIRED outside dev.
# Generate one with: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
# The dev fallback is a known string — incompatible with production.
JWT_SECRET=change-me-to-a-random-secret

# Access token lifetime in seconds (default 4 hours).
# JWT_TTL=14400

# Refresh token lifetime in seconds (default 7 days).
# JWT_REFRESH_TTL=604800

# Optional legacy API-key auth (see DEPRECATION.md for retirement timeline).
# When set, the backend's AuthMiddleware accepts the legacy `X-API-Key`
# header IN ADDITION to JWT. JWT remains the canonical path. Leave unset
# to disable legacy auth entirely.
# API_KEY=some-long-random-secret

# Whether to enable legacy API-Key auth when set (default 1).
# Set to "0" to disable even with API_KEY configured.
# API_KEY_ENABLED=1

# ---------------------------------------------------------------------------
# Inference cache + audit retention — Phase 1-5 knobs
# ---------------------------------------------------------------------------
# 15-minute Redis TTL applied to all /api/v1/inference/* responses.
INFERENCE_CACHE_TTL_SECONDS=900

# Cadence (in seconds) at which Celery beat pre-warms the 4 cache keys
# so the dashboard never sees a cache cold-start after the TTL expires.
INFERENCE_WARM_INTERVAL_SECONDS=840

# Days of inference_audit rows kept in the hot table; older rows are
# moved to inference_audit_archive by the nightly Celery task.
AUDIT_TTL_DAYS=90

# ---------------------------------------------------------------------------
# Real-time + webhook delivery (Phase 3)
# ---------------------------------------------------------------------------
# Optional. When set + WEBHOOK_ENABLED=1, the priority-rank notifier POSTs
# to this URL whenever the #1 ranked action transitions to CRITICAL.
# The body schema is documented in DEPRECATION.md (titled as the CRITICAL
# transition payload).
WEBHOOK_URL=
WEBHOOK_ENABLED=0

# HTTP timeout for the webhook POST (seconds).
WEBHOOK_TIMEOUT_S=5.0

# ---------------------------------------------------------------------------
# Performance smoke testing (Phase 4 harness)
# ---------------------------------------------------------------------------
# When set to 1, pytest tests/test_perf_smoke.py runs as part of the suite.
# Default is off so regular runs stay fast; CI runs opt-in.
PERF_SMOKE=0

# ---------------------------------------------------------------------------
# Optional version string
# ---------------------------------------------------------------------------
# Surfaces in the legacy /health response. Auto-set by the deploy script;
# no need to change in dev.
HMIS_VERSION=2.0.0
